# Hadoop Environment Variables
JAVA_HOME=/opt/java/openjdk
HADOOP_HOME=/opt/hadoop
HADOOP_CONF_DIR=/opt/hadoop/etc/hadoop
HADOOP_LOG_DIR=/opt/hadoop/logs
HADOOP_OPTS="-Djava.library.path=/opt/hadoop/lib/native"

# HDFS Configuration
HDFS_NAMENODE_USER=root
HDFS_DATANODE_USER=root
HDFS_SECONDARYNAMENODE_USER=root

# Core Configuration
CORE_CONF_fs_defaultFS=hdfs://namenode:8020
CORE_CONF_hadoop_http_staticuser_user=root

# HDFS Configuration
HDFS_CONF_dfs_replication=2
HDFS_CONF_dfs_namenode_name_dir=/opt/hadoop/data/namenode
HDFS_CONF_dfs_datanode_data_dir=/opt/hadoop/data/datanode
HDFS_CONF_dfs_namenode_http_address=0.0.0.0:9870
HDFS_CONF_dfs_datanode_http_address=0.0.0.0:9864
HDFS_CONF_dfs_permissions_enabled=false

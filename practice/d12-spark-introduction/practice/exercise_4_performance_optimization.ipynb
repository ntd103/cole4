    "total_result = sales_df.agg(spark_sum(\"total_amount\")).collect()\n",
    "avg_result = sales_df.agg(spark_avg(\"total_amount\")).collect()\n",
    "max_result = sales_df.agg(spark_max(\"total_amount\")).collect()\n",
    "\n",
    "time_multi_pass = time.time() - start_multi_pass\n",
    "\n",
    "print(f\"Multiple passes - Thời gian: {time_multi_pass:.4f} giây\")\n",
    "print(f\"Sum: {total_result[0][0]}\")\n",
    "print(f\"Avg: {avg_result[0][0]}\")\n",
    "print(f\"Max: {max_result[0][0]}\")"
